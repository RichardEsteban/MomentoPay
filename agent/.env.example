# Copia este archivo a agent/.env y completa los valores. .env está en .gitignore.

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opcional: cambia el modelo sin tocar el código
GEMINI_MODEL=gemini-3.8-flash

# Claves secretas de las cuentas de testnet (solo dinero de prueba)
AGENT_SECRET=
PAYER_SECRET=
ADMIN_SECRET=
